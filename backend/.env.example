DB_URL=jdbc:mysql://127.0.0.1:3306/college_club_management?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-with-your-local-mysql-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRATION=86400000

